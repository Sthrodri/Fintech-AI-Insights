# ======================================
# Configuração da API OpenAI
# ======================================
# Obtenha sua chave em: https://platform.openai.com/api-keys
# IMPORTANTE: Nunca commit a chave real no Git! Use este arquivo como template.

OPENAI_API_KEY=sk-your-real-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# ======================================
# Alternativa: Configuração do Ollama (Local)
# ======================================
# Descomente se quiser usar Ollama ao invés de OpenAI
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2

# ======================================
# Configuração do Banco de Dados (Produção)
# ======================================
# Descomentar e configurar quando for usar PostgreSQL em produção

# DB_URL=jdbc:postgresql://localhost:5432/financeira
# DB_USERNAME=finance_user
# DB_PASSWORD=senha-segura-aqui

# ======================================
# Configuração JWT
# ======================================
# Gere uma chave segura com: openssl rand -base64 32
JWT_SECRET=change-me-to-a-secure-secret-key-with-32-chars

# ======================================
# Perfil Ativo (dev ou prod)
# ======================================
SPRING_PROFILES_ACTIVE=dev
